--- /dev/null
+++ b/test/plugin/isWeekend.test.js
@@ -0,0 +1,37 @@
+import MockDate from 'mockdate'
+import dayjs from '../../src'
+import isWeekend from '../../src/plugin/isWeekend'
+import utc from '../../src/plugin/utc'
+
+dayjs.extend(isWeekend)
+dayjs.extend(utc)
+
+beforeEach(() => {
+  MockDate.set(new Date('2024-01-06T12:00:00'))
+})
+
+afterEach(() => {
+  MockDate.reset()
+})
+
+it('is weekend', () => {
+  expect(dayjs().isWeekend()).toBe(true) // Saturday
+  expect(dayjs('2024-01-06').isWeekend()).toBe(true) // Saturday
+  expect(dayjs('2024-01-07').isWeekend()).toBe(true) // Sunday
+})
+
+it('is not weekend', () => {
+  ['2024-01-01', '2024-01-02', '2024-01-03', '2024-01-04', '2024-01-05'].forEach((d) => {
+    expect(dayjs(d).isWeekend()).toBe(false)
+  })
+})
+
+it('is not affected by locale week start', () => {
+  const date = dayjs('2024-01-07').locale({ name: 'test', weekStart: 1 })
+  expect(date.isWeekend()).toBe(true)
+})
+
+it('respects utc mode', () => {
+  expect(dayjs.utc('2024-01-06T00:00:00Z').isWeekend()).toBe(true)
+  expect(dayjs.utc('2024-01-05T23:59:59Z').isWeekend()).toBe(false)
+})
